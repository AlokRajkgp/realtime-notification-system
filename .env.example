# Copy this file to .env for local dev. cmd/api and cmd/worker both load it
# automatically (see internal/config); in Docker/Render/Fly.io, real env
# vars are set instead and this file is ignored.

HTTP_PORT=8080

# Comma-separated list of broker addresses. 19092 is the port docker-compose
# exposes on the host for Redpanda's Kafka API (see docker-compose.yml).
KAFKA_BROKERS=localhost:19092
KAFKA_EVENTS_TOPIC=notifications.events
KAFKA_DLQ_TOPIC=notifications.events.dlq
KAFKA_GROUP_ID=notification-workers

POSTGRES_DSN=postgres://notify:notify@localhost:5433/notify?sslmode=disable

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Retry policy (internal/retry) -- see docs/INTERVIEW_NOTES.md for the
# reasoning behind each of these.
MAX_ATTEMPTS=5
INITIAL_BACKOFF=2s
MAX_BACKOFF=60s
BACKOFF_JITTER=0.2
STALE_CLAIM_TIMEOUT=45s
RECLAIM_INTERVAL=5s
